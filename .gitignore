node_modules/
lib/
dist/
.portable-stage/
# dsh 桌面端本体缓存（611MB，只作本地构建加速，不入库）
.desktop-base/
# 打包中间产物（app/ + profile/ 的临时拼装目录；`--stage` 可带后缀，故用通配）
.desktop-stage*/
# verify:portable 用的解压副本（几百 MB，一次性；本机 safe-delete 会拦大目录删除）
.rel-verify*/
# 手工解压的便携版副本（同上，几百 MB）
.unpack-*/
coverage/
*.tsbuildinfo
*.log
.DS_Store
.env
.env.*
!.env.example
# 本机路径配置的模板要入库；真身 `.env.local` 被上面的 `.env.*` 挡掉（别提交）。
!.env.local.example
.credentials.yaml
**/.credentials.yaml
.desktop-shot.png
.smoke-*.png
.probe-*
.verify-card*.png
.workbuddy/
# P0 事故分布采样落盘（方案 §4；dev-desktop.mjs 默认指到这里）。
# 一次性测量产物，出结论后连模块一起删。
.metrics/
# 真窗口调试脚本的临时输出（一次性的证据快照，不入库）
scripts/.last-*
scripts/.kill-ports.txt

# 排查用的一次性脚本（_tmp* 前缀）
_tmp*
