@@ -0,0 +1,35 @@
+import { mkdirSync, mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import { resolveInstanceName } from '../src/paths.ts'
+
+const roots: string[] = []
+
+function scratch(): string {
+  const root = mkdtempSync(join(tmpdir(), 'dsh-instance-name-'))
+  roots.push(root)
+  return root
+}
+
+/** `<root>\app\<exe>` 与 `<root>\home` 并列 —— 便携包布局。 */
+function portable(name: string): string {
+  const root = join(scratch(), name)
+  mkdirSync(join(root, 'app'), { recursive: true })
+  mkdirSync(join(root, 'home'), { recursive: true })
+  return join(root, 'app', 'DeepSeek Harness.exe')
+}
+
+afterEach(() => { for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true }) })
+
+describe('便携实例名', () => {
+  it('取便携包的根目录名：同名安装复制成多份时，窗口与托盘靠它区分', () => {
+    expect(resolveInstanceName(portable('dsh-A'))).toBe('dsh-A')
+    expect(resolveInstanceName(portable('实例 B'))).toBe('实例 B')
+  })
+
+  it('普通安装（exe 旁边没有 home）没有可区分的名字', () => {
+    const executable = join(scratch(), 'DeepSeek Harness.exe')
+    expect(resolveInstanceName(executable)).toBeUndefined()
+  })
+})
