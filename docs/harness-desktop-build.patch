@@ -0,0 +1,55 @@
+/** 便携版在获取单实例锁前确定所有可写数据目录。 */
+import { resolvePortableDshHome } from './paths.ts'
+import { mkdirSync, realpathSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+
+/** Electron 启动阶段的目录设置接口。 */
+export interface PortableApplicationPaths {
+  setPath(name: 'appData' | 'userData' | 'sessionData' | 'temp' | 'crashDumps', path: string): void
+  setAppLogsPath(path: string): void
+  commandLine: { appendSwitch(name: string, value: string): void }
+}
+
+/**
+ * 初始化便携版数据归属；普通安装不改变系统路径。
+ * @param application - 尚未 ready 的 Electron 应用。
+ * @param executable - 主程序的绝对路径。
+ * @param environment - 主进程与子进程共享的环境。
+ * @returns 检测到的包内 Harness home；普通安装返回 undefined。
+ */
+export function configurePortableData(
+  application: PortableApplicationPaths, executable: string, environment: NodeJS.ProcessEnv,
+): string | undefined {
+  const detected = resolvePortableDshHome(executable)
+  if (detected === undefined) return undefined
+  // realpath 让目录别名与原路径使用同一个 Electron 单实例锁。
+  const home = realpathSync(detected)
+  const data = join(dirname(home), 'data')
+  const appData = join(data, 'app-data')
+  const temporary = join(data, 'temp')
+  const browserHost = (environment.DSH_BROWSER_ELECTRON_HOST ?? '') !== ''
+  const electronPaths = {
+    appData, temp: temporary, crashDumps: join(data, 'crash-dumps'),
+    ...browserHost ? {} : { userData: join(data, 'electron'), sessionData: join(data, 'electron') },
+  }
+  const logs = join(data, 'logs', browserHost ? 'browser' : 'desktop')
+  const overrides: Record<string, string> = {
+    DSH_HOME: home, DSH_AGENTS_HOME: join(home, '.agents'),
+    DSH_PORTABLE_DOCUMENTS_DIR: join(data, 'documents'),
+    DSH_TEMP_DIR: temporary,
+    // 所有新 profile 固定放在 data/browser，不依赖系统 TEMP。
+    DSH_BROWSER_USER_DATA_DIR: join(data, 'browser'),
+    DSH_DESKTOP_UPDATE_JOURNAL_DIR: join(data, 'update-journals'),
+  }
+  // 只设置 DSH 专属变量；外部工具继承原有用户目录、配置和临时目录。
+  for (const directory of [logs, ...Object.values(electronPaths), ...Object.values(overrides)]) {
+    mkdirSync(directory, { recursive: true })
+  }
+  Object.assign(environment, overrides)
+  for (const [name, path] of Object.entries(electronPaths)) {
+    application.setPath(name as Parameters<PortableApplicationPaths['setPath']>[0], path)
+  }
+  application.setAppLogsPath(logs)
+  application.commandLine.appendSwitch('log-file', join(logs, 'chromium.log'))
+  return home
+}
