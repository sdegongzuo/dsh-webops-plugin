+/**
+ * Resolve the harness home of a portable installation, when this is one.
+ *
+ * A portable bundle keeps its data beside the application: `<root>\app\<exe>` and
+ * `<root>\home`. Detecting that sibling lets a double-clicked executable carry its own
+ * configuration and plugins, exactly like launching through the bundle's `启动.cmd`.
+ * @param executablePath - absolute path of the desktop shell executable (`process.execPath`).
+ * @returns the portable home, or undefined when the executable has no sibling `home` directory.
+ */
+export function resolvePortableDshHome(executablePath: string): string | undefined {
+  const portableHome = resolve(dirname(executablePath), '..', 'home')
+  return existsSync(portableHome) ? portableHome : undefined
+}
+
+/**
+ * Name that tells simultaneously running instances apart.
+ *
+ * A portable bundle is `<root>\app\<exe>` with `<root>\home` beside it, so the extracted
+ * folder — the one thing a user names and renames — is the only instance identity that
+ * exists without configuration. Installed builds share one home and keep the bare product
+ * name, so they resolve to `undefined`.
+ * @param executablePath - absolute path of the desktop shell executable (`process.execPath`).
+ * @returns the portable root folder name, or undefined for an installed build.
+ */
+export function resolveInstanceName(executablePath: string): string | undefined {
+  const portableHome = resolvePortableDshHome(executablePath)
+  if (portableHome === undefined) return undefined
+  // 解压到盘根时 basename 是空串 —— 没有可区分的名字，保持原样。
+  const name = basename(dirname(portableHome))
+  return name === '' ? undefined : name
+}
