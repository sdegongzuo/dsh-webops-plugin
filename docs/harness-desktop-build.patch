+/**
+ * The node executable the windows-acl runner argv is prefixed with.
+ *
+ * Deliberately not a bare `process.execPath`: packaged desktop runs the host as
+ * the Electron MAIN executable (`process.execPath` plus the injected
+ * `ELECTRON_RUN_AS_NODE=1`). A spawner that scrubs the child environment — the
+ * PTC runtime keeps only PATH/PATHEXT/SYSTEMROOT/WINDIR/TEMP/TMP — drops that
+ * variable, so prefixing with `process.execPath` hands `runner.js` to Electron
+ * as a GUI app. It then takes the single-instance path and exits 0 without ever
+ * loading the script, so every confined PTC execution fails as
+ * `worker-exit: Node process exited before completing (0)` with no output.
+ *
+ * The desktop package ships a real node for this purpose
+ * (`resources/runtime/primary-runtime/dependencies/node/bin`), so use it
+ * whenever we ARE the Electron runtime and it is present. Do not point at
+ * `resources/runtime/bin/node.cmd`: that shim needs ELECTRON_RUN_AS_NODE and
+ * DSH_DESKTOP_NODE_EXECUTABLE, both stripped from the PTC child env.
+ * Dev, CLI and test runs keep `process.execPath` unchanged.
+ */
+function runnerExecutable(): string {
+  if (process.versions.electron === undefined) return process.execPath
+  const resources = (process as unknown as { resourcesPath?: string }).resourcesPath
+  if (resources === undefined || resources.length === 0) return process.execPath
+  const bundled = join(
+    resources,
+    'runtime',
+    'primary-runtime',
+    'dependencies',
+    'node',
+    'bin',
+    process.platform === 'win32' ? 'node.exe' : 'node',
+  )
+  return existsSync(bundled) ? bundled : process.execPath
+}
