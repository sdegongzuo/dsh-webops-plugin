+    const moduleUrl = (relativePath: string) => pathToFileURL(fileURLToPath(new URL(relativePath, import.meta.url))).href
+    const run = (executable: string) => {
+      const program = `
+        import { configurePortableData } from ${JSON.stringify(moduleUrl('../src/portable-data.ts'))};
+        import { privateRoot, defaultRootsBase, saveTextFile } from ${JSON.stringify(moduleUrl('../../../packages/spill/spill-local/src/store.ts'))};
+        import { prepareManagedProcessBinding, OutputCollector } from ${JSON.stringify(moduleUrl('../../../packages/subprocess/subprocess-local/src/output.ts'))};
+        import { spawnSync } from 'node:child_process';
+        configurePortableData({setPath(){},setAppLogsPath(){},commandLine:{appendSwitch(){}}}, ${JSON.stringify(executable)}, process.env);
+        const root = privateRoot();
+        const saved = await saveTextFile({root,sessionId:'同一个会话',suggestedName:'evidence.txt',content:'工具结果证据'});
+        const binding = prepareManagedProcessBinding();
+        const collector = new OutputCollector(4, 'stdout', {maxBytes:1024,dir:binding.spillDir,onFailure:binding.onSpillFailure});
+        collector.push(Buffer.from('完整进程输出证据'));
+        const output = collector.finalize();
+        const external = spawnSync(process.execPath, ['-e', 'console.log(JSON.stringify({home:require("node:os").homedir(),temp:require("node:os").tmpdir(),npm:process.env.npm_config_userconfig}))'], {env:process.env,encoding:'utf8'});
+        if (external.status !== 0) throw Error(external.stderr);
