+/** Whether a host name is one of the loopback spellings, brackets included. */
+function isLoopback(host: string): boolean {
+  const name = host.replace(/^\[|\]$/g, '').toLowerCase()
+  return name === '127.0.0.1' || name === 'localhost' || name === '::1'
