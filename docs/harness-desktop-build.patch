+    const second = fixture()
+    const start = (executable: string) => {
+      const app = application()
+      const environment: NodeJS.ProcessEnv = { DSH_HOME: '其他安装的 home', DSH_AGENTS_HOME: '系统共享 agents' }
+      configurePortableData(app, executable, environment)
+      const key = app.paths.get('userData') ?? '系统共享 Electron 数据'
+      const owns = claimDesktopSingleInstance({ requestSingleInstanceLock: () => {
+        if (locks.has(key)) return false
+        locks.add(key)
+        return true
+      }, quit: vi.fn(), on: vi.fn() }, vi.fn())
+      return { app, environment, owns }
+    }
+    const a = start(first.executable)
+    writeFileSync(join(first.root, 'home', '会话哨兵.txt'), 'A 的记录')
+    const b = start(second.executable)
+    expect([a.owns, b.owns]).toEqual([true, true])
+    expect(start(first.executable).owns).toBe(false)
+    expect(a.environment.DSH_HOME).toBe(join(first.root, 'home'))
+    expect(b.environment.DSH_HOME).toBe(join(second.root, 'home'))
+    expect(a.environment.DSH_AGENTS_HOME).toBe(join(first.root, 'home', '.agents'))
+    expect(a.environment.DSH_BROWSER_USER_DATA_DIR).toBe(join(first.root, 'data', 'browser'))
+    expect(readFileSync(join(first.root, 'home', '会话哨兵.txt'), 'utf8')).toBe('A 的记录')
+    for (const name of ['appData', 'userData', 'sessionData', 'temp', 'crashDumps', 'logs']) {
+      expect(a.app.paths.get(name)?.startsWith(first.root)).toBe(true)
+      expect(a.app.paths.get(name)).not.toBe(b.app.paths.get(name))
+    }
+  })
