 /** Filesystem ownership for the Electron-managed desktop installation. */
 
-import { join } from 'node:path'
+import { existsSync } from 'node:fs'
+import { dirname, join, resolve } from 'node:path'
 import { resolveDshHome } from '@deepseek-ai/dsh-home-paths'
 
 /** Stable desktop installation paths under the shared Harness home. */
@@ -40,3 +41,17 @@ export function resolveDesktopPaths(dshHome: string = resolveDshHome()): Desktop
     },
   }
 }
+
+/**
+ * Resolve the harness home of a portable installation, when this is one.
+ *
+ * A portable bundle keeps its data beside the application: `<root>\app\<exe>` and
+ * `<root>\home`. Detecting that sibling lets a double-clicked executable carry its own
+ * configuration and plugins, exactly like launching through the bundle's `启动.cmd`.
+ * @param executablePath - absolute path of the desktop shell executable (`process.execPath`).
+ * @returns the portable home, or undefined when the executable has no sibling `home` directory.
+ */
+export function resolvePortableDshHome(executablePath: string): string | undefined {
+  const portableHome = resolve(dirname(executablePath), '..', 'home')
+  return existsSync(portableHome) ? portableHome : undefined
+}
